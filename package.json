{
  "name": "@lookui/calendar",
  "version": "0.1.0",
  "description": "A modular, imperative calendar & scheduler built on @lookui/core — month/week/day/agenda views, drag-to-create, drag-to-move, resize, recurrence, and a customizable built-in event form.",
  "author": {
    "name": "Bambang Yudhotomo",
    "url": "https://github.com/bambangy"
  },
  "homepage": "https://bambangy.github.io/LookCalendar/docs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bambangy/LookCalendar.git"
  },
  "bugs": {
    "url": "https://github.com/bambangy/LookCalendar/issues"
  },
  "main": "dist/look-calendar.cjs",
  "module": "dist/look-calendar.esm.js",
  "style": "dist/look-calendar.css",
  "unpkg": "dist/look-calendar.min.js",
  "jsdelivr": "dist/look-calendar.min.js",
  "exports": {
    ".": {
      "import": "./dist/look-calendar.esm.js",
      "require": "./dist/look-calendar.cjs",
      "default": "./dist/look-calendar.esm.js"
    },
    "./look-calendar.css": "./dist/look-calendar.css",
    "./look-calendar.min.css": "./dist/look-calendar.min.css",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build:js": "rollup -c rollup.config.js",
    "build:css": "sass src/scss/main.scss dist/look-calendar.raw.css --no-source-map && postcss dist/look-calendar.raw.css --config .postcssrc.cjs --no-map -o dist/look-calendar.css && rimraf dist/look-calendar.raw.css && node scripts/minify-css.js",
    "build": "npm run build:js && npm run build:css",
    "dev": "rollup -c rollup.config.js --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:docs": "node scripts/smoke-docs.mjs",
    "prepublishOnly": "npm run build && npm run test && npm run test:docs"
  },
  "keywords": [
    "calendar",
    "scheduler",
    "ui",
    "vanilla",
    "lookui"
  ],
  "type": "module",
  "license": "MIT",
  "peerDependencies": {
    "@lookui/core": ">=0.4.1"
  },
  "devDependencies": {
    "@lookui/core": ">=0.4.1",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-terser": "^1.0.0",
    "autoprefixer": "^10.6.1",
    "cssnano": "^9.1.2",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.0",
    "postcss-cli": "^12.0.0",
    "rimraf": "^6.1.3",
    "rollup": "^4.63.6",
    "sass": "^1.105.1",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
